# Backend environment variables
# Copy this file to .env and fill in the values

# Database — for local dev leave as SQLite; Render will inject the real PostgreSQL URL automatically
DATABASE_URL=sqlite:///./chess.db

# JWT secret — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# URL of the deployed frontend (used for CORS allowlist)
# Example: https://chess-frontend.onrender.com
FRONTEND_URL=
